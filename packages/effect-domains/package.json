    "./sqlite-identity": "./src/identity/sqlite/index.ts",
    "./sqlite-migrations": "./src/sqlite/migrations.ts",
    "./sqlite-ddl": "./src/sqlite/ddl.ts",
    "./read-model": "./src/read-model/index.ts",
