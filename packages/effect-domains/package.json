    "./application-runtime": "./src/application-runtime.ts",
    "./application-telemetry": "./src/application-telemetry.ts",
    "./authorization": "./src/authorization.ts",
    "./authorization-model": "./src/authorization-model.ts",
    "./authorization-rpc": "./src/authorization-rpc.ts",
    "./domain": "./src/domain.ts",
    "./entitlements": "./src/entitlements.ts",
    "./feature-flags": "./src/feature-flags.ts",
    "./identity": "./src/identity.ts",
    "./identity-rpc": "./src/identity-rpc.ts",
    "./migrations": "./src/migrations.ts",
    "./command": "./src/command.ts",
    "./page": "./src/page.ts",
    "./infrastructure": "./src/infrastructure.ts",
    "./infrastructure-compiler": "./src/infrastructure-compiler.ts",
    "./infrastructure-inspect": "./src/infrastructure-inspect.ts",
    "./policy": "./src/policy.ts",
    "./policy-sql": "./src/policy-sql.ts",
    "./repository-store": "./src/repository-store.ts",
    "./resource": "./src/resource.ts",
    "./rpc-cli": "./src/rpc-cli.ts",
    "./rpc-mcp": "./src/rpc-mcp.ts",
    "./sqlite-bun": "./src/sqlite-bun.ts",
    "./sqlite-node": "./src/sqlite-node.ts",
    "./sqlite-identity": "./src/sqlite-identity.ts",
    "./sqlite-migrations": "./src/sqlite-migrations.ts",
    "./sqlite-ddl": "./src/sqlite-ddl.ts",
    "./read-model": "./src/read-model.ts",
    "./table": "./src/table.ts",
    "./table-check-model": "./src/table-check-model.ts",
    "./physical-table-definition-error": "./src/physical-table-definition-error.ts",
    "./physical-table-field": "./src/physical-table-field.ts",
    "./physical-table-relations": "./src/physical-table-relations.ts",
    "./table-relation-input": "./src/table-relation-input.ts",
