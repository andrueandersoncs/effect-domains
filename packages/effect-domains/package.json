    "./authorization": "./src/authorization/index.ts",
    "./authorization-model": "./src/authorization/model.ts",
    "./authorization-rpc": "./src/authorization/rpc.ts",
    "./domain": "./src/domain.ts",
    "./entitlements": "./src/authorization/entitlements.ts",
    "./feature-flags": "./src/application/feature-flags.ts",
    "./identity": "./src/identity/index.ts",
    "./identity-groups": "./src/identity/groups/index.ts",
    "./identity-rpc": "./src/identity/rpc.ts",
    "./migrations": "./src/sqlite/schema-store.ts",
