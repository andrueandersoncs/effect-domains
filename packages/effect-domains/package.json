  "files": [
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint:file-lines": "bun run scripts/check-file-lines.ts",
    "lint": "bun run lint:file-lines && better-typescript"
  },
  "dependencies": {
    "@effect-domains/application-ui": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
