{
  "name": "effect-domains-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "catalog": {
    "effect": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112"
  },
  "scripts": {
    "build": "bun run --filter @effect-domains/admin build && bun run --filter @effect-domains/example-web build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "bun run --workspaces check && tsc --noEmit",
    "lint": "bun run --workspaces lint && better-typescript",
    "test": "bun --bun vitest run",
    "orders-invoices": "bun run examples/orders-invoices/main.ts",
    "orders-invoices:server": "bun run examples/orders-invoices/main.ts serve",
    "purchased-guides": "bun run examples/purchased-guides/main.ts",
    "purchased-guides:server": "bun run examples/purchased-guides/main.ts serve",
    "equipment-register": "bun run examples/equipment-register/main.ts",
    "equipment-register:server": "bun run examples/equipment-register/main.ts serve",
    "equipment-register:client": "bun run examples/equipment-register/client.ts",
    "report-exports": "bun run examples/report-exports/main.ts",
    "report-exports:server": "bun run examples/report-exports/main.ts serve",
    "report-exports:worker": "bun run examples/report-exports/main.ts worker",
    "appointment-reminders": "bun run examples/appointment-reminders/main.ts",
    "appointment-reminders:server": "bun run examples/appointment-reminders/main.ts serve",
    "appointment-reminders:worker": "bun run examples/appointment-reminders/main.ts worker",
    "reservations:server": "bun run examples/reservations/main.ts serve",
    "reservations": "bun run examples/reservations/main.ts",
    "reading-list:server": "bun run examples/reading-list/main.ts serve",
    "reading-list": "bun run examples/reading-list/main.ts",
    "reading-list:server:otel": "OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 bun run examples/reading-list/main.ts serve",
    "reading-list:otel": "OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 bun run examples/reading-list/main.ts",
    "expense-ledger:server": "bun run examples/expense-ledger/main.ts serve",
    "expense-ledger": "bun run examples/expense-ledger/main.ts",
    "team-tasks:server": "bun run examples/team-tasks/main.ts serve",
    "team-tasks": "bun run examples/team-tasks/main.ts",
    "field-notes:server": "bun run examples/field-notes/main.ts serve",
    "field-notes": "bun run examples/field-notes/main.ts",
    "editorial-calendar:server": "bun run examples/editorial-calendar/main.ts serve",
    "editorial-calendar": "bun run examples/editorial-calendar/main.ts",
    "repair-workshop": "bun run examples/repair-workshop/main.ts",
    "repair-workshop:server": "bun run examples/repair-workshop/main.ts serve",
    "editorial-calendar:seed-v1": "bun run examples/editorial-calendar/seed-v1.ts"
  },
  "devDependencies": {
    "@better-typescript/better-typescript": "0.4.14",
    "@effect-domains/example-support": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "latest",
    "effect": "catalog:",
    "effect-domains": "workspace:*",
    "typescript": "^7",
    "vitepress": "1.6.4",
    "vitest": "4.1.11",
    "vue": "3.5.42"
  }
}
