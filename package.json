{
  "name": "effect-domains-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "effect": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112"
  },
  "scripts": {
    "build": "bun run --filter @effect-domains/admin build",
    "check": "bun run --workspaces check && tsc --noEmit",
    "lint": "bun run --workspaces lint && better-typescript",
    "test": "bun --bun vitest run",
    "mcp-server": "bun run apps/mcp-server/main.ts",
    "mcp-server:server": "bun run apps/mcp-server/main.ts serve",
    "mcp-server:client": "bun run apps/mcp-server/client.ts",
    "durable-workflows": "bun run apps/durable-workflows/main.ts",
    "durable-workflows:server": "bun run apps/durable-workflows/main.ts serve",
    "durable-workflows:worker": "bun run apps/durable-workflows/main.ts worker",
    "durable-reminders": "bun run apps/durable-reminders/main.ts",
    "durable-reminders:server": "bun run apps/durable-reminders/main.ts serve",
    "durable-reminders:worker": "bun run apps/durable-reminders/main.ts worker",
    "reservations:server": "bun run apps/reservations/main.ts serve",
    "reservations": "bun run apps/reservations/main.ts",
    "basic-crud:server": "bun run apps/basic-crud/main.ts serve",
    "basic-crud": "bun run apps/basic-crud/main.ts",
    "authored-sql:server": "bun run apps/authored-sql/main.ts serve",
    "authored-sql": "bun run apps/authored-sql/main.ts",
    "resource-crud:server": "bun run apps/resource-crud/main.ts serve",
    "resource-crud": "bun run apps/resource-crud/main.ts",
    "service-codec:server": "bun run apps/service-codec/main.ts serve",
    "service-codec": "bun run apps/service-codec/main.ts",
    "persisted-ref:server": "bun run apps/persisted-ref/main.ts serve",
    "persisted-ref": "bun run apps/persisted-ref/main.ts",
    "migration-lifecycle:server": "bun run apps/migration-lifecycle/main.ts serve",
    "migration-lifecycle": "bun run apps/migration-lifecycle/main.ts",
    "migration-lifecycle:seed-v1": "bun run apps/migration-lifecycle/seed-v1.ts"
  },
  "devDependencies": {
    "@better-typescript/better-typescript": "0.4.14",
    "@effect/vitest": "catalog:",
    "@types/bun": "latest",
    "vitest": "4.1.11",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "effect": "catalog:",
    "@effect-domains/example-support": "workspace:*",
    "effect-domains": "workspace:*",
    "typescript": "^7"
  }
}
